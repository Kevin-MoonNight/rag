{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rag-desktop",
  "version": "0.1.0",
  "identifier": "local.rag.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文件搜尋",
        "width": 1240,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}

--- a/tools/rag-check/rag-check.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/rag-check/rag-check.cpp	2026-10-12 17:14:12.962984700 +0000
@@ -0,0 +1,286 @@
+// [rag] rag-check: verifies that the Gemma 4 early output crop does not change the results.
+//
+// The same prompts are processed twice, in two contexts created from the same model:
+//   - reference: RAG_NO_EARLY_CROP=1 (original graph)
+//   - test     : early crop enabled
+// For each case the logits of the requested prompt positions and of n_gen teacher-forced
+// generation steps are compared (the generation steps read the KV cache written by the prefill).
+//
+// usage: rag-check <model.gguf> [n_threads] [n_gen]
+
+#include "llama.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+struct test_case {
+    int              n_prompt;   // number of prompt tokens
+    std::vector<int> extra_out;  // extra output positions in the prompt (the last token is always output)
+};
+
+struct run_result {
+    std::vector<std::vector<float>> logits; // prompt outputs (in position order), then generation steps
+    std::vector<llama_token>        gen;
+    double                          t_prefill_ms = 0.0;
+};
+
+static const char * TEXT =
+    "The bank's internal audit policy requires that every loan application above five million dollars be "
+    "reviewed by two independent credit officers before approval. \xE6\x9C\xAC\xE8\xA1\x8C\xE5\x85\xA7\xE9\x83\xA8"
+    "\xE7\xA8\xBD\xE6\xA0\xB8\xE8\xA6\x8F\xE5\xAE\x9A\xEF\xBC\x8C\xE8\xB6\x85\xE9\x81\x8E\xE4\xBA\x94\xE7\x99\xBE"
+    "\xE8\x90\xAC\xE5\x85\x83\xE7\x9A\x84\xE8\xB2\xB8\xE6\xAC\xBE\xE7\x94\xB3\xE8\xAB\x8B\xE9\xA0\x88\xE7\xB6\x93"
+    "\xE5\x85\xA9\xE4\xBD\x8D\xE6\x8E\x88\xE4\xBF\xA1\xE4\xBA\xBA\xE5\x93\xA1\xE5\x88\x86\xE5\x88\xA5\xE5\xAF\xA9"
+    "\xE6\x9F\xA5\xE3\x80\x82 Patients admitted to the cardiology ward must have their medication list reconciled "
+    "within twenty-four hours, and any discrepancy is reported to the attending physician. "
+    "\xE7\x97\x85\xE4\xBA\xBA\xE5\x85\xA5\xE4\xBD\x8F\xE5\xBF\x83\xE8\x87\x9F\xE5\x85\xA7\xE7\xA7\x91\xE7\x97\x85"
+    "\xE6\x88\xBF\xE5\xBE\x8C\xEF\xBC\x8C\xE9\xA0\x88\xE6\x96\xBC\xE4\xBA\x8C\xE5\x8D\x81\xE5\x9B\x9B\xE5\xB0\x8F"
+    "\xE6\x99\x82\xE5\x85\xA7\xE5\xAE\x8C\xE6\x88\x90\xE7\x94\xA8\xE8\x97\xA5\xE6\xA0\xB8\xE5\xB0\x8D\xE3\x80\x82 "
+    "Section 4.2 describes the retention period for transaction records: seven years for corporate accounts and "
+    "five years for personal accounts, counted from the date the account is closed. ";
+
+static std::vector<llama_token> make_tokens(const llama_vocab * vocab, int n) {
+    std::string text;
+    int i = 0;
+    while ((int) text.size() < n * 8) {
+        text += TEXT;
+        text += "(" + std::to_string(++i) + ") ";
+    }
+    std::vector<llama_token> tokens(text.size() + 16);
+    const int n_tok = llama_tokenize(vocab, text.c_str(), (int32_t) text.size(), tokens.data(), (int32_t) tokens.size(), true, false);
+    if (n_tok < n) {
+        fprintf(stderr, "not enough tokens: %d < %d\n", n_tok, n);
+        exit(1);
+    }
+    tokens.resize(n);
+    return tokens;
+}
+
+static run_result run(llama_context * ctx, const llama_vocab * vocab, const std::vector<llama_token> & prompt,
+                      const std::vector<int> & extra_out, int n_gen, const std::vector<llama_token> * forced) {
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+    const int n_batch = (int) llama_n_batch(ctx);
+
+    run_result res;
+
+    llama_memory_clear(llama_get_memory(ctx), true);
+
+    const int n_prompt = (int) prompt.size();
+
+    const auto t0 = std::chrono::steady_clock::now();
+
+    for (int i0 = 0; i0 < n_prompt; i0 += n_batch) {
+        const int n = std::min(n_batch, n_prompt - i0);
+
+        llama_batch batch = llama_batch_init(n, 0, 1);
+        std::vector<int> out_idx;
+        for (int i = 0; i < n; i++) {
+            const int pos = i0 + i;
+            const bool out = pos == n_prompt - 1 || std::find(extra_out.begin(), extra_out.end(), pos) != extra_out.end();
+            batch.token   [i]    = prompt[pos];
+            batch.pos     [i]    = pos;
+            batch.n_seq_id[i]    = 1;
+            batch.seq_id  [i][0] = 0;
+            batch.logits  [i]    = out;
+            if (out) {
+                out_idx.push_back(i);
+            }
+        }
+        batch.n_tokens = n;
+
+        if (llama_decode(ctx, batch) != 0) {
+            fprintf(stderr, "llama_decode failed\n");
+            exit(1);
+        }
+        for (const int i : out_idx) {
+            const float * l = llama_get_logits_ith(ctx, i);
+            res.logits.emplace_back(l, l + n_vocab);
+        }
+        llama_batch_free(batch);
+    }
+
+    res.t_prefill_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+
+    for (int g = 0; g < n_gen; g++) {
+        llama_token tok;
+        if (forced) {
+            tok = (*forced)[g];
+        } else {
+            const auto & l = res.logits.back();
+            tok = (llama_token) (std::max_element(l.begin(), l.end()) - l.begin());
+        }
+        res.gen.push_back(tok);
+
+        llama_batch batch = llama_batch_init(1, 0, 1);
+        batch.token   [0]    = tok;
+        batch.pos     [0]    = n_prompt + g;
+        batch.n_seq_id[0]    = 1;
+        batch.seq_id  [0][0] = 0;
+        batch.logits  [0]    = true;
+        batch.n_tokens       = 1;
+        if (llama_decode(ctx, batch) != 0) {
+            fprintf(stderr, "llama_decode failed\n");
+            exit(1);
+        }
+        const float * l = llama_get_logits_ith(ctx, 0);
+        res.logits.emplace_back(l, l + n_vocab);
+        llama_batch_free(batch);
+    }
+
+    return res;
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2) {
+        fprintf(stderr, "usage: %s <model.gguf> [n_threads] [n_gen]\n", argv[0]);
+        return 1;
+    }
+    const int n_threads = argc > 2 ? atoi(argv[2]) : 6;
+    const int n_gen     = argc > 3 ? atoi(argv[3]) : 8;
+
+    llama_backend_init();
+
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = 0;
+    mparams.load_mode    = LLAMA_LOAD_MODE_NONE;
+    mparams.lazy_mode    = LLAMA_LAZY_MODE_ON;
+
+    llama_model * model = llama_model_load_from_file(argv[1], mparams);
+    if (!model) {
+        fprintf(stderr, "failed to load model\n");
+        return 1;
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    const std::vector<test_case> cases = {
+        {    1, {}              },
+        {   10, {}              },
+        {   10, { 0, 3 }        },
+        {  100, { 50 }          },
+        {  512, {}              },
+        {  513, {}              },
+        {  600, {}              }, // ubatches: 512 (no output) + 88 (1 output)
+        {  600, { 5, 511, 512 } },
+        { 1500, {}              }, // longer than the sliding window
+        { 2500, { 2047, 2048 }  }, // more than one batch
+    };
+
+    std::vector<std::vector<llama_token>> prompts;
+    for (const auto & c : cases) {
+        prompts.push_back(make_tokens(vocab, c.n_prompt));
+    }
+
+    // mode 0: reference (early crop disabled)
+    // mode 1: early crop enabled
+    // mode 2: reference with one thread less  (noise floor: same graph, different work split)
+    // mode 3: reference with n_ubatch = 128   (noise floor: same math, different batch shapes)
+    const int n_modes = 4;
+    std::vector<run_result> results[4];
+
+    for (int mode = 0; mode < n_modes; mode++) {
+        if (mode != 1) {
+            setenv("RAG_NO_EARLY_CROP", "1", 1);
+        } else {
+            unsetenv("RAG_NO_EARLY_CROP");
+        }
+
+        const int n_threads_cur = mode == 2 ? std::max(1, n_threads - 1) : n_threads;
+
+        llama_context_params cparams = llama_context_default_params();
+        cparams.n_ctx           = 4096;
+        cparams.n_batch         = 2048;
+        cparams.n_ubatch        = mode == 3 ? 128 : 512;
+        cparams.n_threads       = n_threads_cur;
+        cparams.n_threads_batch = n_threads_cur;
+        cparams.no_perf         = true;
+
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        if (!ctx) {
+            fprintf(stderr, "failed to create context\n");
+            return 1;
+        }
+
+        // warmup
+        run(ctx, vocab, prompts[1], {}, 1, nullptr);
+
+        for (size_t i = 0; i < cases.size(); i++) {
+            const std::vector<llama_token> * forced = mode != 0 ? &results[0][i].gen : nullptr;
+            results[mode].push_back(run(ctx, vocab, prompts[i], cases[i].extra_out, n_gen, forced));
+        }
+
+        llama_free(ctx);
+    }
+
+    struct diff {
+        double max_d = 0.0;
+        double nmse  = 0.0;
+        int    n_argmax_diff = 0;
+    };
+
+    const auto compare = [](const run_result & a, const run_result & b) {
+        diff d;
+        double se = 0.0, s0 = 0.0;
+        GGML_ASSERT(a.logits.size() == b.logits.size());
+        for (size_t k = 0; k < a.logits.size(); k++) {
+            const auto & la = a.logits[k];
+            const auto & lb = b.logits[k];
+            for (size_t j = 0; j < la.size(); j++) {
+                // tokens removed by a pruned output head are -inf in both runs; anything else non-finite is an error
+                if (!std::isfinite(la[j]) || !std::isfinite(lb[j])) {
+                    if (la[j] != lb[j]) {
+                        d.max_d = INFINITY;
+                        d.n_argmax_diff++;
+                    }
+                    continue;
+                }
+                const double x = (double) la[j] - (double) lb[j];
+                d.max_d = std::max(d.max_d, std::fabs(x));
+                se += x * x;
+                s0 += (double) la[j] * (double) la[j];
+            }
+            if (std::max_element(la.begin(), la.end()) - la.begin() != std::max_element(lb.begin(), lb.end()) - lb.begin()) {
+                d.n_argmax_diff++;
+            }
+        }
+        d.nmse = se / s0;
+        return d;
+    };
+
+    bool ok = true;
+
+    // the early crop passes when it agrees with the reference at least as well as the reference agrees with itself
+    // (quantized mat-muls are not bit-reproducible across batch shapes / thread counts)
+    printf("\n%8s %5s | %9s %9s %7s | %-27s | %-18s | %-18s\n", "n_prompt", "n_out", "ref ms", "crop ms", "speedup",
+           "crop vs ref: max|d| NMSE am", "threads-1: NMSE am", "ubatch128: NMSE am");
+    double nmse_crop_max = 0.0, nmse_noise_max = 0.0;
+    for (size_t i = 0; i < cases.size(); i++) {
+        const diff dc = compare(results[0][i], results[1][i]);
+        const diff dt = compare(results[0][i], results[2][i]);
+        const diff du = compare(results[0][i], results[3][i]);
+
+        nmse_crop_max  = std::max(nmse_crop_max,  dc.nmse);
+        nmse_noise_max = std::max(nmse_noise_max, std::max(dt.nmse, du.nmse));
+
+        ok = ok && dc.n_argmax_diff == 0;
+
+        printf("%8d %5zu | %9.1f %9.1f %6.2fx | %9.2e %9.2e %-6s | %9.2e %-6s | %9.2e %-6s\n",
+               cases[i].n_prompt, cases[i].extra_out.size() + 1,
+               results[0][i].t_prefill_ms, results[1][i].t_prefill_ms, results[0][i].t_prefill_ms / results[1][i].t_prefill_ms,
+               dc.max_d, dc.nmse, dc.n_argmax_diff == 0 ? "same" : "DIFF",
+               dt.nmse, dt.n_argmax_diff == 0 ? "same" : "DIFF",
+               du.nmse, du.n_argmax_diff == 0 ? "same" : "DIFF");
+    }
+
+    printf("\nmax NMSE: crop vs ref = %.2e, reference noise floor = %.2e\n", nmse_crop_max, nmse_noise_max);
+    ok = ok && nmse_crop_max <= std::max(4.0 * nmse_noise_max, 1e-6);
+
+    printf("\n%s\n", ok ? "RESULT: PASS" : "RESULT: FAIL");
+
+    llama_model_free(model);
+
+    return ok ? 0 : 1;
+}
diff -ruN a/tools/rag-check/rag-headcheck.cpp b/tools/rag-check/rag-headcheck.cpp
--- a/tools/rag-check/rag-headcheck.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/rag-check/rag-headcheck.cpp	2026-10-12 14:01:01.653177400 +0000
@@ -0,0 +1,188 @@
+// [rag] rag-headcheck: verifies a GGUF with a pruned output head against the original file.
+//
+// Both files are run on the same prompt and the same (teacher-forced) continuation. For every step:
+//   - the logits of the kept tokens must match the original (same quantized rows, so only float noise)
+//   - the logits of the removed tokens must be -inf
+// It also reports how often the original model's top token was a removed one, and the decode speed.
+//
+// usage: rag-headcheck <original.gguf> <pruned.gguf> [n_threads] [n_gen]
+
+#include "llama.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+struct run_result {
+    std::vector<std::vector<float>> logits;
+    std::vector<llama_token>        gen;
+    double                          ms_per_token = 0.0;
+};
+
+static const char * PROMPT =
+    "<bos><|turn>user\n"
+    "\xE8\xAB\x8B\xE7\x94\xA8\xE7\xB9\x81\xE9\xAB\x94\xE4\xB8\xAD\xE6\x96\x87\xE8\xAA\xAA\xE6\x98\x8E\xE9\x8A\x80"
+    "\xE8\xA1\x8C\xE7\x82\xBA\xE4\xBB\x80\xE9\xBA\xBC\xE8\xA6\x81\xE4\xBF\x9D\xE5\xAD\x98\xE4\xBA\xA4\xE6\x98\x93"
+    "\xE7\xB4\x80\xE9\x8C\x84\xEF\xBC\x8C\xE4\xB8\xA6\xE8\x88\x89\xE4\xB8\x80\xE5\x80\x8B\xE8\x8B\xB1\xE6\x96\x87"
+    "\xE8\xA1\x93\xE8\xAA\x9E\xE3\x80\x82<turn|>\n<|turn>model\n";
+
+static run_result run(const char * path, int n_threads, int n_gen, const std::vector<llama_token> * forced) {
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = 0;
+    mparams.load_mode    = LLAMA_LOAD_MODE_NONE;
+    mparams.lazy_mode    = LLAMA_LAZY_MODE_ON;
+
+    llama_model * model = llama_model_load_from_file(path, mparams);
+    if (!model) {
+        fprintf(stderr, "failed to load %s\n", path);
+        exit(1);
+    }
+    const llama_vocab * vocab   = llama_model_get_vocab(model);
+    const int           n_vocab = llama_vocab_n_tokens(vocab);
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx           = 2048;
+    cparams.n_batch         = 512;
+    cparams.n_ubatch        = 512;
+    cparams.n_threads       = n_threads;
+    cparams.n_threads_batch = n_threads;
+    cparams.no_perf         = true;
+
+    llama_context * ctx = llama_init_from_model(model, cparams);
+
+    std::vector<llama_token> prompt(512);
+    const int n_prompt = llama_tokenize(vocab, PROMPT, (int32_t) strlen(PROMPT), prompt.data(), (int32_t) prompt.size(), false, true);
+    prompt.resize(n_prompt);
+
+    run_result res;
+
+    llama_batch batch = llama_batch_init(n_prompt, 0, 1);
+    for (int i = 0; i < n_prompt; i++) {
+        batch.token   [i]    = prompt[i];
+        batch.pos     [i]    = i;
+        batch.n_seq_id[i]    = 1;
+        batch.seq_id  [i][0] = 0;
+        batch.logits  [i]    = i == n_prompt - 1;
+    }
+    batch.n_tokens = n_prompt;
+    if (llama_decode(ctx, batch) != 0) {
+        exit(1);
+    }
+    {
+        const float * l = llama_get_logits_ith(ctx, n_prompt - 1);
+        res.logits.emplace_back(l, l + n_vocab);
+    }
+    llama_batch_free(batch);
+
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int g = 0; g < n_gen; g++) {
+        llama_token tok;
+        if (forced) {
+            tok = (*forced)[g];
+        } else {
+            const auto & l = res.logits.back();
+            tok = (llama_token) (std::max_element(l.begin(), l.end()) - l.begin());
+        }
+        res.gen.push_back(tok);
+
+        llama_batch b = llama_batch_init(1, 0, 1);
+        b.token   [0]    = tok;
+        b.pos     [0]    = n_prompt + g;
+        b.n_seq_id[0]    = 1;
+        b.seq_id  [0][0] = 0;
+        b.logits  [0]    = true;
+        b.n_tokens       = 1;
+        if (llama_decode(ctx, b) != 0) {
+            exit(1);
+        }
+        const float * l = llama_get_logits_ith(ctx, 0);
+        res.logits.emplace_back(l, l + n_vocab);
+        llama_batch_free(b);
+    }
+    res.ms_per_token = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() / n_gen;
+
+    if (!forced) {
+        std::string text;
+        for (const llama_token t : res.gen) {
+            char buf[64];
+            const int n = llama_token_to_piece(vocab, t, buf, sizeof(buf), 0, false);
+            if (n > 0) {
+                text.append(buf, n);
+            }
+        }
+        printf("\n--- greedy output of the original file ---\n%s\n---\n", text.c_str());
+    }
+
+    llama_free(ctx);
+    llama_model_free(model);
+    return res;
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s <original.gguf> <pruned.gguf> [n_threads] [n_gen]\n", argv[0]);
+        return 1;
+    }
+    const int n_threads = argc > 3 ? atoi(argv[3]) : 6;
+    const int n_gen     = argc > 4 ? atoi(argv[4]) : 96;
+
+    // keep the comparison independent of the other patch
+    setenv("RAG_NO_EARLY_CROP", "1", 1);
+
+    llama_backend_init();
+
+    const run_result a = run(argv[1], n_threads, n_gen, nullptr);
+    const run_result b = run(argv[2], n_threads, n_gen, &a.gen);
+
+    size_t n_kept = 0, n_removed = 0;
+    for (const float v : b.logits[0]) {
+        if (std::isinf(v)) {
+            n_removed++;
+        } else {
+            n_kept++;
+        }
+    }
+
+    double max_d = 0.0, se = 0.0, s0 = 0.0;
+    int n_top_removed = 0, n_top_diff = 0;
+    bool ok = true;
+    for (size_t k = 0; k < a.logits.size(); k++) {
+        const auto & la = a.logits[k];
+        const auto & lb = b.logits[k];
+        const size_t top_a = std::max_element(la.begin(), la.end()) - la.begin();
+        const size_t top_b = std::max_element(lb.begin(), lb.end()) - lb.begin();
+        if (std::isinf(lb[top_a])) {
+            n_top_removed++;
+        } else if (top_a != top_b) {
+            n_top_diff++;
+        }
+        for (size_t j = 0; j < la.size(); j++) {
+            if (std::isinf(lb[j])) {
+                ok = ok && lb[j] < 0 && std::isinf(b.logits[0][j]); // the same tokens are removed at every step
+                continue;
+            }
+            const double d = (double) la[j] - (double) lb[j];
+            max_d = std::max(max_d, std::fabs(d));
+            se += d * d;
+            s0 += (double) la[j] * (double) la[j];
+        }
+    }
+    const double nmse = se / s0;
+
+    printf("\nvocab: %zu kept, %zu removed (%.1f%% kept)\n", n_kept, n_removed, 100.0 * n_kept / (n_kept + n_removed));
+    printf("steps compared                       : %zu\n", a.logits.size());
+    printf("kept-token logits, max |d| / NMSE    : %.2e / %.2e\n", max_d, nmse);
+    printf("top token differs (both kept)        : %d\n", n_top_diff);
+    printf("original top token was a removed one : %d\n", n_top_removed);
+    printf("decode: original %.2f ms/token (%.1f t/s), pruned %.2f ms/token (%.1f t/s), %.2fx\n",
+           a.ms_per_token, 1000.0 / a.ms_per_token, b.ms_per_token, 1000.0 / b.ms_per_token, a.ms_per_token / b.ms_per_token);
+
+    ok = ok && nmse < 1e-3 && n_top_diff == 0;
+    printf("\n%s\n", ok ? "RESULT: PASS" : "RESULT: FAIL");
+    return ok ? 0 : 1;
+}
diff -ruN a/tools/rag-check/rag-headcost.cpp b/tools/rag-check/rag-headcost.cpp
--- a/tools/rag-check/rag-headcost.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/rag-check/rag-headcost.cpp	2026-10-12 13:51:36.860141100 +0000
@@ -0,0 +1,123 @@
+// [rag] rag-headcost: measures how much of the per-token decode time is spent in the output head (lm_head).
+//
+// Tokens are decoded one at a time, once with logits requested and once without. With RAG_NO_EARLY_CROP=1
+// all the layers still run when no logits are requested (the rows are dropped at the last layer), so the
+// difference between the two is the cost of the output head (plus the tail of the last layer).
+//
+// usage: rag-headcost <model.gguf> [n_threads] [n_tokens]
+
+#include "llama.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+static double decode_tokens(llama_context * ctx, const std::vector<llama_token> & tokens, int n_ctx_fill, bool logits) {
+    llama_memory_clear(llama_get_memory(ctx), true);
+
+    // fill some context first so that the attention has something to look at
+    {
+        llama_batch batch = llama_batch_init(n_ctx_fill, 0, 1);
+        for (int i = 0; i < n_ctx_fill; i++) {
+            batch.token   [i]    = tokens[i];
+            batch.pos     [i]    = i;
+            batch.n_seq_id[i]    = 1;
+            batch.seq_id  [i][0] = 0;
+            batch.logits  [i]    = false;
+        }
+        batch.n_tokens = n_ctx_fill;
+        if (llama_decode(ctx, batch) != 0) {
+            fprintf(stderr, "llama_decode failed\n");
+            exit(1);
+        }
+        llama_batch_free(batch);
+    }
+
+    const int n = (int) tokens.size() - n_ctx_fill;
+
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int i = 0; i < n; i++) {
+        llama_batch batch = llama_batch_init(1, 0, 1);
+        batch.token   [0]    = tokens[n_ctx_fill + i];
+        batch.pos     [0]    = n_ctx_fill + i;
+        batch.n_seq_id[0]    = 1;
+        batch.seq_id  [0][0] = 0;
+        batch.logits  [0]    = logits;
+        batch.n_tokens       = 1;
+        if (llama_decode(ctx, batch) != 0) {
+            fprintf(stderr, "llama_decode failed\n");
+            exit(1);
+        }
+        llama_batch_free(batch);
+    }
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() / n;
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2) {
+        fprintf(stderr, "usage: %s <model.gguf> [n_threads] [n_tokens]\n", argv[0]);
+        return 1;
+    }
+    const int n_threads = argc > 2 ? atoi(argv[2]) : 6;
+    const int n_tokens  = argc > 3 ? atoi(argv[3]) : 64;
+    const int n_fill    = 256;
+
+    setenv("RAG_NO_EARLY_CROP", "1", 1);
+
+    llama_backend_init();
+
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = 0;
+    mparams.load_mode    = LLAMA_LOAD_MODE_NONE;
+    mparams.lazy_mode    = LLAMA_LAZY_MODE_ON;
+
+    llama_model * model = llama_model_load_from_file(argv[1], mparams);
+    if (!model) {
+        return 1;
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    std::string text;
+    for (int i = 0; i < 200; i++) {
+        text += "The retention period for transaction records is seven years for corporate accounts. ";
+    }
+    std::vector<llama_token> tokens(text.size());
+    const int n = llama_tokenize(vocab, text.c_str(), (int32_t) text.size(), tokens.data(), (int32_t) tokens.size(), true, false);
+    if (n < n_fill + n_tokens) {
+        return 1;
+    }
+    tokens.resize(n_fill + n_tokens);
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx           = 2048;
+    cparams.n_batch         = 512;
+    cparams.n_ubatch        = 512;
+    cparams.n_threads       = n_threads;
+    cparams.n_threads_batch = n_threads;
+    cparams.no_perf         = true;
+
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (!ctx) {
+        return 1;
+    }
+
+    decode_tokens(ctx, tokens, n_fill, true); // warmup
+
+    double ms_with = 0.0, ms_without = 0.0;
+    const int n_rep = 3;
+    for (int r = 0; r < n_rep; r++) {
+        ms_with    += decode_tokens(ctx, tokens, n_fill, true)  / n_rep;
+        ms_without += decode_tokens(ctx, tokens, n_fill, false) / n_rep;
+    }
+
+    printf("\nthreads = %d\n", n_threads);
+    printf("per token, with logits   : %7.2f ms (%.1f t/s)\n", ms_with,    1000.0 / ms_with);
+    printf("per token, without logits: %7.2f ms (%.1f t/s)\n", ms_without, 1000.0 / ms_without);
+    printf("output head              : %7.2f ms = %.1f%% of the per-token time\n", ms_with - ms_without, 100.0 * (ms_with - ms_without) / ms_with);
+
+    llama_free(ctx);
+    llama_model_free(model);
+    return 0;
+}
